# Copy this file to .env and fill in your values. .env is git-ignored.
# All settings are optional — the app runs without any of them.

# CourtListener REST token (full authenticated opinion text). https://www.courtlistener.com/api/
COURTLISTENER_TOKEN=

# Nebius Token Factory API Key — powers autonomous research and case enrichment. https://docs.tokenfactory.nebius.com/quickstart
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Optional custom base URL (defaults to https://api.tokenfactory.nebius.com/v1)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# TypeSafe AI API Key — System One model (jev-latest) for sub-100ms case triage & intent routing. https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional legacy fallback:
# GOOGLE_GEMINI_KEY=

# Delivery sinks (POST /api/deliver)
CASEFILE_WEBHOOK_URL=
CASEFILE_ARCHIVE_DIR=

# Set to the number of proxies in front of the app (e.g. 1 on Render/Railway/Fly)
# so per-IP rate limits use the real client IP. Leave unset when directly
# internet-facing — otherwise clients can spoof X-Forwarded-For to bypass limits.
TRUST_PROXY=

# Hard ceiling (bytes) on a single court-download fetch. Oversized responses are
# aborted mid-stream so a hostile endpoint cannot exhaust memory. Default 2 MB.
MAX_DOWNLOAD_BYTES=

# Absolute wall-clock budget (ms) for one download: DNS + connect + redirects +
# body. Enforced even if the peer trickles bytes. Default 10000.
DOWNLOAD_TIMEOUT_MS=

# Max records one /api/deliver call may fan out to webhook/disk sinks (default 25).
# NOTE: /api/deliver also requires CASEFILE_ACCESS_PASSWORD to be set.
MAX_DELIVER_BATCH=
