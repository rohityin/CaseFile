{
  "version": "2.0.0",
  "tasks": [
    {
      // Starts only the Vite web server; the API runs under the debugger instead
      // (see launch.json) so backend breakpoints work. Marked background so the
      // Chrome launch waits until Vite prints its "Local:" URL.
      "label": "vite-dev",
      "type": "shell",
      "command": "npm run dev:web",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^\\s*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      }
    }
  ]
}
